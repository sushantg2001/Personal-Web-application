# .dockerignore
#
# The build context is the repo root. Everything below is either reinstalled
# inside the image (node_modules), regenerated by the build (.next, out), or
# has nothing to do with serving the site.

# dependencies — reinstalled by `bun install` in the builder stage.
# Never ship the host's copy: it carries platform-specific binaries.
node_modules

# build output — regenerated by `bun run build`
.next
out
build
*.tsbuildinfo
next-env.d.ts

# not part of the served site
design-system
scripts
README.md
CLAUDE.md
.claude
.github
justfile

# local + editor cruft
.git
.env*
.DS_Store
*.pem
Dockerfile
.dockerignore
